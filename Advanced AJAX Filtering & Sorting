			var wasOpen = $dd.hasClass( 'is-open' );
			$( '.alf-dropdown' ).removeClass( 'is-open' );
			if ( ! wasOpen ) $dd.addClass( 'is-open' );
		} );
		$( document ).on( 'click', function () {
			$( '.alf-dropdown' ).removeClass( 'is-open' );
		} );
		$( document ).on( 'click', '.alf-dropdown-panel', function ( e ) {
			e.stopPropagation();
		} );

		// ---- Keep desktop dropdown + mobile drawer checkboxes in sync ----
		$( document ).on( 'change', WRAPPER + ' input[type="checkbox"]', function () {
			var name = $( this ).attr( 'name' );
			var value = $( this ).val();
			var checked = $( this ).is( ':checked' );
			$( WRAPPER + ' input[type="checkbox"][name="' + name + '"][value="' + value + '"]' ).prop( 'checked', checked );
		} );
		$( document ).on( 'input change', WRAPPER + ' .alf-min-price, ' + WRAPPER + ' .alf-max-price', function () {
			var cls = $( this ).hasClass( 'alf-min-price' ) ? 'alf-min-price' : 'alf-max-price';
			$( WRAPPER + ' .' + cls ).val( $( this ).val() );
		} );

		// ---- Sort dropdown ----
		$( document ).on( 'click', '.alf-sort-panel li', function () {
			var value = $( this ).data( 'value' );
			var label = $( this ).text();
			$( '.alf-sort-panel li' ).removeClass( 'is-active' );
			$( this ).addClass( 'is-active' );
			$( '#alf-sort-label' ).text( label );
			$( '#alf-orderby' ).val( value );
			$( WRAPPER + ' .alf-mobile-sort' ).val( value );
			$( '.alf-dropdown' ).removeClass( 'is-open' );
			currentPage = 1;
			runFilter();
		} );
		$( document ).on( 'change', WRAPPER + ' .alf-mobile-sort', function () {
			var value = $( this ).val();
			var label = $( this ).find( 'option:selected' ).text();
			$( '#alf-orderby' ).val( value );
			$( '#alf-sort-label' ).text( label );
			$( '.alf-sort-panel li' ).removeClass( 'is-active' ).filter( '[data-value="' + value + '"]' ).addClass( 'is-active' );
		} );

		// ---- Mobile drawer open/close ----
		$( document ).on( 'click', '#alf-open-drawer', function () {
			$( '#alf-mobile-drawer, #alf-drawer-overlay' ).addClass( 'is-open' );
		} );
		function closeDrawer() {
			$( '#alf-mobile-drawer, #alf-drawer-overlay' ).removeClass( 'is-open' );
		}
		$( document ).on( 'click', '#alf-close-drawer, #alf-drawer-overlay', closeDrawer );

		// ---- Gather + run ----
		function gatherFilters() {
			var data = {
				action: 'alf_filter_products',
				nonce: ALF_Vars.nonce,
				category: [],
				color: [],
				material: [],
				min_price: $( WRAPPER + ' .alf-min-price' ).first().val() || ALF_Vars.minPrice,
				max_price: $( WRAPPER + ' .alf-max-price' ).first().val() || ALF_Vars.maxPrice,
				orderby: $( '#alf-orderby' ).val() || 'menu_order',
				paged: currentPage,
				per_page: 12
			};

			$( WRAPPER + ' input[name="category"]:checked' ).each( function () {
				if ( data.category.indexOf( $( this ).val() ) === -1 ) data.category.push( $( this ).val() );
			} );
			$( WRAPPER + ' input[name="color"]:checked' ).each( function () {
				if ( data.color.indexOf( $( this ).val() ) === -1 ) data.color.push( $( this ).val() );
			} );
			$( WRAPPER + ' input[name="material"]:checked' ).each( function () {
				if ( data.material.indexOf( $( this ).val() ) === -1 ) data.material.push( $( this ).val() );
			} );

			return data;
		}

		function updateURLParams( data ) {
			if ( ! window.history || ! window.history.replaceState ) return;
			var params = new URLSearchParams();
			if ( data.category.length ) params.set( 'category', data.category.join( ',' ) );
			if ( data.color.length ) params.set( 'color', data.color.join( ',' ) );
			if ( data.material.length ) params.set( 'material', data.material.join( ',' ) );
			if ( data.orderby !== 'menu_order' ) params.set( 'orderby', data.orderby );
			var newUrl = window.location.pathname + ( params.toString() ? '?' + params.toString() : '' );
			window.history.replaceState( {}, '', newUrl );
		}

		function runFilter() {
			var data = gatherFilters();
			updateURLParams( data );
			$grid().addClass( 'alf-loading' );

			$.ajax( {
				url: ALF_Vars.ajax_url,
				type: 'POST',
				data: data,
				success: function ( response ) {
					if ( response.success ) {
						$grid().html( response.data.html );
						$( '#alf-results-count' ).text( 'Showing ' + response.data.post_count + ' of ' + response.data.found_posts + ' items' );
					} else {
						$grid().html( '<div class="alf-error">Something went wrong. Please try again.</div>' );
					}
				},
				error: function () {
					$grid().html( '<div class="alf-error">Unable to load filters. Please refresh the page.</div>' );
				},
				complete: function () {
					$grid().removeClass( 'alf-loading' );
				}
			} );
		}

		function debouncedFilter() {
			clearTimeout( debounceTimer );
			debounceTimer = setTimeout( function () {
				currentPage = 1;
				runFilter();
			}, 350 );
		}

		$( document ).ready( function () {
			$( '#alf-results-count' ).text( 'Showing ' + Math.min( 12, ALF_Vars.totalCount ) + ' of ' + ALF_Vars.totalCount + ' items' );

			$( document ).on( 'change', WRAPPER + ' input[type="checkbox"]', debouncedFilter );
			$( document ).on( 'click', WRAPPER + ' .alf-panel-apply', function () {
				$( '.alf-dropdown' ).removeClass( 'is-open' );
				currentPage = 1;
				runFilter();
			} );

			$( document ).on( 'click', '#alf-mobile-clear, #alf-clear-filters', function () {
				$( WRAPPER + ' input[type="checkbox"]' ).prop( 'checked', false );
				$( WRAPPER + ' .alf-min-price' ).val( ALF_Vars.minPrice );
				$( WRAPPER + ' .alf-max-price' ).val( ALF_Vars.maxPrice );
				$( '#alf-orderby' ).val( 'menu_order' );
				$( '#alf-sort-label' ).text( 'Featured' );
				$( '.alf-sort-panel li' ).removeClass( 'is-active' ).filter( '[data-value="menu_order"]' ).addClass( 'is-active' );
				$( WRAPPER + ' .alf-mobile-sort' ).val( 'menu_order' );
				currentPage = 1;
				runFilter();
			} );

			$( document ).on( 'click', '#alf-mobile-apply', function () {
				closeDrawer();
				currentPage = 1;
				runFilter();
			} );
		} );

	} )( jQuery );
	</script>
	<?php
}
add_action( 'wp_footer', 'alf_print_inline_js_css' );
