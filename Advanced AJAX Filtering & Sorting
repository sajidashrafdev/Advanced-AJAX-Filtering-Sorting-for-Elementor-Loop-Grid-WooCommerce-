 * STEP 2: AJAX Handler — core filtering/sorting logic (AND across
 * taxonomies, OR within same taxonomy, + price range + sort)
 * -----------------------------------------------------------------------
 */
add_action( 'wp_ajax_alf_filter_products', 'alf_filter_products_callback' );
add_action( 'wp_ajax_nopriv_alf_filter_products', 'alf_filter_products_callback' );

function alf_filter_products_callback() {

	check_ajax_referer( 'alf_filter_nonce', 'nonce' );

	$taxonomies = alf_get_filter_taxonomies();

	$selected_cats      = isset( $_POST['category'] ) ? array_map( 'sanitize_text_field', (array) $_POST['category'] ) : array();
	$selected_colors    = isset( $_POST['color'] )    ? array_map( 'sanitize_text_field', (array) $_POST['color'] )    : array();
	$selected_materials = isset( $_POST['material'] ) ? array_map( 'sanitize_text_field', (array) $_POST['material'] ) : array();
	$min_price          = isset( $_POST['min_price'] ) ? floatval( $_POST['min_price'] ) : '';
	$max_price          = isset( $_POST['max_price'] ) ? floatval( $_POST['max_price'] ) : '';
	$orderby_raw        = isset( $_POST['orderby'] ) ? sanitize_text_field( $_POST['orderby'] ) : 'menu_order';
	$paged              = isset( $_POST['paged'] ) ? max( 1, intval( $_POST['paged'] ) ) : 1;
	$per_page           = isset( $_POST['per_page'] ) ? intval( $_POST['per_page'] ) : 12;

	$args = array(
		'post_type'      => 'product',
		'post_status'    => 'publish',
		'posts_per_page' => $per_page,
		'paged'          => $paged,
	);

	$tax_query = array( 'relation' => 'AND' );

	if ( ! empty( $selected_cats ) ) {
		$tax_query[] = array(
			'taxonomy' => $taxonomies['category'],
			'field'    => 'slug',
			'terms'    => $selected_cats,
			'operator' => 'IN',
		);
	}
	if ( ! empty( $selected_colors ) ) {
		$tax_query[] = array(
			'taxonomy' => $taxonomies['color'],
			'field'    => 'slug',
			'terms'    => $selected_colors,
			'operator' => 'IN',
		);
	}
	if ( ! empty( $selected_materials ) ) {
		$tax_query[] = array(
			'taxonomy' => $taxonomies['material'],
			'field'    => 'slug',
			'terms'    => $selected_materials,
			'operator' => 'IN',
		);
	}
	if ( count( $tax_query ) > 1 ) {
		$args['tax_query'] = $tax_query;
	}

	if ( $min_price !== '' && $max_price !== '' ) {
		$args['meta_query'] = array(
			array(
				'key'     => '_price',
				'value'   => array( $min_price, $max_price ),
				'compare' => 'BETWEEN',
				'type'    => 'NUMERIC',
			),
		);
	}

	switch ( $orderby_raw ) {
		case 'price-asc':
			$args['orderby']  = 'meta_value_num';
			$args['meta_key'] = '_price';
			$args['order']    = 'ASC';
			break;
		case 'price-desc':
			$args['orderby']  = 'meta_value_num';
			$args['meta_key'] = '_price';
			$args['order']    = 'DESC';
			break;
		case 'popularity':
			$args['orderby']  = 'meta_value_num';
			$args['meta_key'] = 'total_sales';
			$args['order']    = 'DESC';
			break;
		case 'rating':
			$args['orderby']  = 'meta_value_num';
			$args['meta_key'] = '_wc_average_rating';
			$args['order']    = 'DESC';
			break;
		case 'date':
			$args['orderby'] = 'date';
			$args['order']   = 'DESC';
			break;
		case 'title':
			$args['orderby'] = 'title';
			$args['order']   = 'ASC';
			break;
		default:
			$args['orderby'] = 'menu_order date';
			$args['order']   = 'ASC';
			break;
	}

	$args = apply_filters( 'alf_query_args', $args );

	$query = new WP_Query( $args );

	ob_start();

	if ( $query->have_posts() ) {
		while ( $query->have_posts() ) {
			$query->the_post();
			alf_render_single_item();
		}
		wp_reset_postdata();
	} else {
		echo '<div class="alf-no-products">No products found for this filter combination.</div>';
	}

	$html = ob_get_clean();

	wp_send_json_success( array(
		'html'        => $html,
		'found_posts' => $query->found_posts,
		'post_count'  => $query->post_count,
		'max_pages'   => $query->max_num_pages,
		'paged'       => $paged,
	) );
}

function alf_render_single_item() {
	if ( ALF_LOOP_TEMPLATE_ID && class_exists( '\Elementor\Plugin' ) ) {

		// $with_css = false: sirf per-widget STATIC CSS (colors, margins,
		// fonts) hota hai, jo already page load par ek baar globally load
		// ho chuka hota hai — dobara include karne se sirf response bhaari
		// hota hai, kuch fayda nahi.
		echo \Elementor\Plugin::instance()->frontend->get_builder_content_for_display( ALF_LOOP_TEMPLATE_ID, false );

		// Background-image (product photo) Elementor apne internal
		// per-post "dynamic CSS" mechanism se generate karta hai jo sirf
		// widget ke NATIVE render flow me chalta hai — get_builder_content_for_display()
		// se ye include nahi hoti. Isliye hum ise khud, seedha product ki
		// featured image se, regenerate kar rahe hain — bilkul usi
		// selector ko target karke jo Elementor khud use karta hai.
		$img_url = get_the_post_thumbnail_url( get_the_ID(), 'large' );
		if ( $img_url ) {
			printf(
				'<style>.e-loop-item-%d .elementor-element.%s{background-image:url(%s) !important;}</style>',
				get_the_ID(),
				esc_attr( ALF_LOOP_BG_ELEMENT_CLASS ),
				esc_url( $img_url )
			);
		}
		return;
	}
	wc_get_template_part( 'content', 'product' );
}

