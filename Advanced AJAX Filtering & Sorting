/**
 * Renders ONE filter group's checkbox list (used for both the desktop
 * dropdown version AND the mobile drawer version, so both stay in sync).
 */
function alf_render_checkbox_group( $taxonomy_slug, $field_name ) {
	$terms = get_terms( array( 'taxonomy' => $taxonomy_slug, 'hide_empty' => true ) );
	if ( is_wp_error( $terms ) ) return;
	foreach ( $terms as $term ) : ?>
		<label class="alf-checkbox">
			<input type="checkbox" name="<?php echo esc_attr( $field_name ); ?>" value="<?php echo esc_attr( $term->slug ); ?>">
			<span><?php echo esc_html( $term->name ); ?></span>
		</label>
	<?php endforeach;
}

