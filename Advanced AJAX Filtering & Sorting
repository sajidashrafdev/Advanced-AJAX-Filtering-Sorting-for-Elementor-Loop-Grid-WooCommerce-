function alf_get_filter_taxonomies() {
	return array(
		'category' => 'product_cat',
		'color'    => 'product_color',
		'material' => 'product_material',
	);
}

/**
 * -----------------------------------------------------------------------
 * STEP 1: Price bounds helper
 * -----------------------------------------------------------------------
 */
function alf_get_price_bounds() {
	global $wpdb;
	$result = $wpdb->get_row( "
		SELECT MIN(CAST(meta_value AS DECIMAL(10,2))) as min_price,
		       MAX(CAST(meta_value AS DECIMAL(10,2))) as max_price
		FROM {$wpdb->postmeta}
		WHERE meta_key = '_price' AND meta_value != ''
	" );

	return array(
		'min' => $result && $result->min_price ? floor( $result->min_price ) : 0,
		'max' => $result && $result->max_price ? ceil( $result->max_price ) : 10000,
	);
}

/**
 * Total published product count — used for the initial "Showing X of Y
 * items" text before any filter has run.
 */
function alf_get_total_products_count() {
	$counts = wp_count_posts( 'product' );
	return isset( $counts->publish ) ? (int) $counts->publish : 0;
}

